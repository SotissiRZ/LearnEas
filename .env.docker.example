# Copier ce fichier en `.env` à la racine du projet avant de lancer `docker compose up`.
# `docker compose` charge automatiquement le fichier `.env` du répertoire courant.
#
# Configuration ci-dessous = DÉVELOPPEMENT LOCAL.
# Pour Railway/production : DEBUG=False + SECRET_KEY longue et aléatoire + domaines publics.

# --- Django ---
SECRET_KEY=dev-secret-key-change-me
DEBUG=True
# Bac à sable interne : simule un paiement réussi sans prestataire. TOUJOURS False en production.
TEST_PAYMENTS_ENABLED=True
# Limites globales DRF. Les endpoints sensibles (auth/reset/paiement) ont leurs propres quotas.
ANON_THROTTLE_RATE=10000/hour
USER_THROTTLE_RATE=30000/hour
MEDIA_THROTTLE_RATE=5000/hour
CERTIFICATE_VERIFY_THROTTLE_RATE=300/hour
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# --- Base de données (Postgres, service "db") ---
POSTGRES_DB=learneas
POSTGRES_USER=learneas
POSTGRES_PASSWORD=change-me-too

# --- URLs / CORS ---
# En local avec nginx sur le port 80 par défaut :
HTTP_PORT=80
FRONTEND_URL=http://localhost
BACKEND_PUBLIC_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# URL relative : le navigateur reste sur sa propre origine (localhost OU 127.0.0.1) — voir
# frontend/lib/api.ts pour l'explication détaillée. Ne changez ceci que pour un domaine dédié.
NEXT_PUBLIC_API_URL=/api

# --- Salle vidéo KalanPro (WebRTC) ---
RTC_STUN_URL=stun:stun.l.google.com:19302
RTC_TURN_URL=
# Préféré avec coturn REST : secret partagé générant des credentials temporaires.
RTC_TURN_SECRET=
RTC_TURN_TTL_SECONDS=3600
# Fallback fournisseur TURN statique (reste côté backend).
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=
# Signalisation/presence temps reel via Django Channels. Vide en Docker local (same-origin /ws).
NEXT_PUBLIC_WS_URL=
REALTIME_TICKET_MAX_AGE_SECONDS=60
REALTIME_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
REALTIME_CHANNEL_CAPACITY=500
REALTIME_CHANNEL_EXPIRY_SECONDS=60
# STUN suffit sur beaucoup de réseaux. En production, configurez également un TURN pour les
# participants derrière des NAT/pare-feu restrictifs.

# Passez à True UNIQUEMENT si un reverse proxy termine du vrai HTTPS devant l'application
# (Traefik/Caddy/Certbot...). Sinon laissez False : sinon les cookies de session/CSRF ne sont
# plus envoyés par le navigateur en HTTP simple, et les formulaires (dont /admin/) échouent avec
# une erreur "403 - La vérification CSRF a échoué".
USE_HTTPS=False

# --- Paiement (à renseigner en production) ---
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=EUR

# --- Commission et versements instructeurs ---
PLATFORM_COMMISSION_PERCENT=15
MINIMUM_PAYOUT_AMOUNT=10

# --- Email (mot de passe oublié, notifications) ---
# Laissé vide = console backend (le lien s'affiche dans les logs "docker compose logs backend")
# En production, renseigner un vrai serveur SMTP :
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=KalanPro <no-reply@kalanpro.com>

# --- Démo ---
# Passez à "true" pour insérer automatiquement les données de démonstration
# (admin@kalanpro.com / admin1234) au premier démarrage. À laisser "false" en production.
SEED_DEMO=false

# Paiements additionnels (secrets uniquement côté serveur)
YOUCANPAY_ACCESS_TOKEN=
YOUCANPAY_API_BASE=https://youcanpay.com/api/v2
YOUCANPAY_SANDBOX_ACCESS_TOKEN=
YOUCANPAY_SANDBOX_API_BASE=
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_API_BASE=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_SANDBOX_API_KEY=
GENIUSPAY_SANDBOX_API_SECRET=
GENIUSPAY_SANDBOX_WEBHOOK_SECRET=
GENIUSPAY_SANDBOX_API_BASE=

# CinetPay Mobile Money (Côte d'Ivoire, Sénégal, Cameroun, etc.)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_API_BASE=https://api-checkout.cinetpay.com/v2
CINETPAY_SANDBOX_API_KEY=
CINETPAY_SANDBOX_SITE_ID=
CINETPAY_SANDBOX_SECRET_KEY=
CINETPAY_SANDBOX_API_BASE=

# Stockage média persistant (recommandé/nécessaire sur Railway)
USE_S3=False
REQUIRE_REMOTE_MEDIA=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# Uploads pédagogiques
MAX_VIDEO_UPLOAD_MB=2048
MAX_PDF_UPLOAD_MB=100
MAX_IMAGE_UPLOAD_MB=15
PRIVATE_MEDIA_TOKEN_MAX_AGE=900
HLS_MEDIA_TOKEN_MAX_AGE=21600
VIDEO_NORMALIZATION_ENABLED=True
VIDEO_PROBE_TIMEOUT_SECONDS=120
VIDEO_TRANSCODE_TIMEOUT_SECONDS=3600
VIDEO_TRANSCODE_PRESET=veryfast
VIDEO_TRANSCODE_CRF=22
HLS_STREAMING_ENABLED=True
HLS_MAX_HEIGHT=720
HLS_SEGMENT_SECONDS=6
HLS_TRANSCODE_TIMEOUT_SECONDS=7200
HLS_TRANSCODE_PRESET=veryfast
HLS_AUDIO_ONLY_BITRATE=48k

# Origine du CDN/S3/R2 utilisée par hls.js après redirection des segments (production).
NEXT_PUBLIC_MEDIA_ORIGIN=

# --- WhatsApp Cloud API (Meta) ---
# En local : activez WHATSAPP_ENABLED=True + laissez WHATSAPP_DRY_RUN=True pour tester sans envoi réel.
# En production : WHATSAPP_DRY_RUN=False et renseignez les identifiants Meta.
WHATSAPP_ENABLED=False
WHATSAPP_DRY_RUN=True
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_HTTP_TIMEOUT=15


# Projets / portfolio
MAX_PROJECT_UPLOAD_MB=50

# Refresh JWT HttpOnly. Docker local fonctionne en HTTP, donc Secure=False ici uniquement.
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_PATH=/api/auth/
AUTH_REFRESH_COOKIE_MAX_AGE=604800

# Développement local : scanner facultatif. En production, gardez MALWARE_SCAN_REQUIRED=True.
MALWARE_SCAN_ENABLED=False
MALWARE_SCAN_REQUIRED=False
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
