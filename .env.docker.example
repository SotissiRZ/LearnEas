# Copier ce fichier en `.env` à la racine du projet avant de lancer `docker compose up`.
# `docker compose` charge automatiquement le fichier `.env` du répertoire courant.

# --- Django ---
SECRET_KEY=change-me-please-use-a-long-random-string-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# --- Base de données (Postgres, service "db") ---
POSTGRES_DB=learneas
POSTGRES_USER=learneas
POSTGRES_PASSWORD=change-me-too

# --- URLs / CORS ---
# En local avec nginx sur le port 80 par défaut :
HTTP_PORT=80
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
# URL relative : le navigateur reste sur sa propre origine (localhost OU 127.0.0.1) — voir
# frontend/lib/api.ts pour l'explication détaillée. Ne changez ceci que pour un domaine dédié.
NEXT_PUBLIC_API_URL=/api

# --- Salle vidéo LearnEas (WebRTC) ---
# STUN suffit sur beaucoup de réseaux. En production, configurez également un TURN pour les
# participants derrière des NAT/pare-feu restrictifs.
NEXT_PUBLIC_RTC_STUN_URL=stun:stun.l.google.com:19302
NEXT_PUBLIC_RTC_TURN_URL=
NEXT_PUBLIC_RTC_TURN_USERNAME=
NEXT_PUBLIC_RTC_TURN_CREDENTIAL=

# Passez à True UNIQUEMENT si un reverse proxy termine du vrai HTTPS devant l'application
# (Traefik/Caddy/Certbot...). Sinon laissez False : sinon les cookies de session/CSRF ne sont
# plus envoyés par le navigateur en HTTP simple, et les formulaires (dont /admin/) échouent avec
# une erreur "403 - La vérification CSRF a échoué".
USE_HTTPS=False

# --- Paiement (à renseigner en production) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Commission et versements instructeurs ---
PLATFORM_COMMISSION_PERCENT=15
MINIMUM_PAYOUT_AMOUNT=100

# --- Email (mot de passe oublié, notifications) ---
# Laissé vide = console backend (le lien s'affiche dans les logs "docker compose logs backend")
# En production, renseigner un vrai serveur SMTP :
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=LearnEas <no-reply@learneas.com>

# --- Démo ---
# Passez à "true" pour insérer automatiquement les données de démonstration
# (admin@learneas.com / admin1234) au premier démarrage. À laisser "false" en production.
SEED_DEMO=false
