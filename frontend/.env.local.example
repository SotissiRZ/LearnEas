NEXT_PUBLIC_API_URL=http://localhost:8000/api

NEXT_PUBLIC_MAX_VIDEO_UPLOAD_MB=2048

# Origine du CDN/S3/R2 utilisée par hls.js après redirection des segments (production).
NEXT_PUBLIC_MEDIA_ORIGIN=

# Production Vercel recommandé : laissez NEXT_PUBLIC_API_URL=/api puis proxyfiez vers Railway.
# API_PROXY_TARGET est serveur-only et ne doit PAS se terminer par /api.
# Exemple : API_PROXY_TARGET=https://learneas-backend-production.up.railway.app
API_PROXY_TARGET=

# WebSocket ASGI. En dev `npm run dev`, le frontend est sur :3000 et Django sur :8000.
# En production Vercel : wss://learneas-backend-production.up.railway.app/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

NEXT_PUBLIC_UPLOAD_TIMEOUT_MS=600000

NEXT_PUBLIC_UPLOAD_PART_TIMEOUT_MS=300000

PUBLIC_API_TIMEOUT_MS=8000
