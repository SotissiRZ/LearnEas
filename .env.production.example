# KalanPro production — exemple uniquement, ne jamais committer les vraies valeurs.
SECRET_KEY=replace-with-at-least-32-random-characters
DEBUG=False
TEST_PAYMENTS_ENABLED=False
SEED_DEMO=False
USE_HTTPS=True
LOG_FORMAT=json
LOG_LEVEL=INFO

ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
REALTIME_ALLOWED_ORIGINS=https://www.example.com
CSRF_TRUSTED_ORIGINS=https://www.example.com
FRONTEND_URL=https://www.example.com
BACKEND_PUBLIC_URL=https://api.example.com
AUTH_REFRESH_COOKIE_SECURE=True
AUTH_REFRESH_COOKIE_SAMESITE=Lax

DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://host:6379/0

USE_S3=True
REQUIRE_REMOTE_MEDIA=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

MALWARE_SCAN_ENABLED=True
MALWARE_SCAN_REQUIRED=True
CLAMAV_HOST=
CLAMAV_PORT=3310

# Paiement / email / WhatsApp / IA : renseigner uniquement les fournisseurs réellement activés.

# Timeouts frontend (ms)
NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_UPLOAD_TIMEOUT_MS=600000
NEXT_PUBLIC_UPLOAD_PART_TIMEOUT_MS=300000
PUBLIC_API_TIMEOUT_MS=8000

# Images
MAX_IMAGE_UPLOAD_MB=15
MAX_IMAGE_DIMENSION=12000
MAX_IMAGE_PIXELS=60000000
CLIENT_TELEMETRY_THROTTLE_RATE=60/hour

# --- Vidéo hors connexion contrôlée (v81) ---
# Génère une copie MP4 basse définition uniquement pour les leçons explicitement autorisées.
OFFLINE_VIDEO_ENABLED=True
OFFLINE_VIDEO_MAX_HEIGHT=360
OFFLINE_VIDEO_MAX_MB=250
# 30 jours : durée maximale du jeton signé permettant de resynchroniser le temps vu hors ligne.
OFFLINE_PROGRESS_TOKEN_MAX_AGE=2592000
