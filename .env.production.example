# KalanPro production — exemple uniquement, ne jamais committer les vraies valeurs.
SECRET_KEY=replace-with-at-least-32-random-characters
DEBUG=False
TEST_PAYMENTS_ENABLED=False
SEED_DEMO=False
USE_HTTPS=True
LOG_FORMAT=json
LOG_LEVEL=INFO

ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
REALTIME_ALLOWED_ORIGINS=https://www.example.com
CSRF_TRUSTED_ORIGINS=https://www.example.com
FRONTEND_URL=https://www.example.com
BACKEND_PUBLIC_URL=https://api.example.com
AUTH_REFRESH_COOKIE_SECURE=True
AUTH_REFRESH_COOKIE_SAMESITE=Lax

DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://host:6379/0

# V91 — WebRTC/TURN. Prévoir au moins UDP + TLS/TCP pour les réseaux mobiles/restrictifs.
RTC_STUN_URLS=stun:stun.l.google.com:19302
RTC_TURN_URLS=
RTC_TURN_SECRET=
RTC_TURN_TTL_SECONDS=3600
RTC_MESH_SOFT_LIMIT=6
RTC_SFU_RECOMMEND_THRESHOLD=7
# Préparation uniquement : ne renseigner que lorsqu'un vrai adaptateur SFU est déployé.
RTC_SFU_URL=
RTC_ICE_TRANSPORT_POLICY=all
RTC_ICE_CANDIDATE_POOL_SIZE=2
RTC_DISCONNECT_GRACE_SECONDS=8
RTC_QUALITY_INTERVAL_SECONDS=10
RTC_QUALITY_TTL_SECONDS=180
RTC_VIDEO_MAX_BITRATE_KBPS=900
RTC_AUDIO_MAX_BITRATE_KBPS=64

USE_S3=True
REQUIRE_REMOTE_MEDIA=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
# V89: CDN public optionnel avec accès origine au bucket privé. Exemple: https://media.example.com
PUBLIC_MEDIA_BASE_URL=
MEDIA_PUBLIC_CACHE_SECONDS=31536000
MEDIA_PRIVATE_CACHE_CONTROL=private, no-store
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=10
MULTIPART_UPLOAD_MAX_AGE_HOURS=24
MULTIPART_CLEANUP_MAX_ABORTS=200
OPERATIONS_STORAGE_SCAN_MAX_OBJECTS=2000
OPERATIONS_QUEUE_WARNING_DEPTH=100
DIRECT_MEDIA_UPLOADS_ENABLED=True
DIRECT_UPLOAD_PART_SIZE_MB=16
DIRECT_UPLOAD_URL_TTL_SECONDS=3600
HLS_STREAMING_ENABLED=True
HLS_MAX_HEIGHT=720
HLS_SEGMENT_SECONDS=6
HLS_SEGMENT_CACHE_SECONDS=600

MALWARE_SCAN_ENABLED=True
MALWARE_SCAN_REQUIRED=True
CLAMAV_HOST=
CLAMAV_PORT=3310

# Paiement / email / WhatsApp / IA : renseigner uniquement les fournisseurs réellement activés.

# Timeouts frontend (ms)
NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_UPLOAD_TIMEOUT_MS=600000
NEXT_PUBLIC_UPLOAD_PART_TIMEOUT_MS=300000
PUBLIC_API_TIMEOUT_MS=8000

# Images
MAX_IMAGE_UPLOAD_MB=15
MAX_IMAGE_DIMENSION=12000
MAX_IMAGE_PIXELS=60000000
CLIENT_TELEMETRY_THROTTLE_RATE=60/hour
PRODUCT_ANALYTICS_THROTTLE_RATE=300/hour
ANALYTICS_RETENTION_DAYS=395

# --- Vidéo hors connexion contrôlée (v81) ---
# Génère une copie MP4 basse définition uniquement pour les leçons explicitement autorisées.
OFFLINE_VIDEO_ENABLED=True
OFFLINE_VIDEO_MAX_HEIGHT=360
OFFLINE_VIDEO_MAX_MB=250
# 30 jours : durée maximale du jeton signé permettant de resynchroniser le temps vu hors ligne.
OFFLINE_PROGRESS_TOKEN_MAX_AGE=2592000

# --- Notifications multicanal (v82) ---
# Resend
RESEND_ENABLED=False
RESEND_DRY_RUN=False
RESEND_API_KEY=
RESEND_API_BASE=https://api.resend.com
RESEND_HTTP_TIMEOUT=15

# WhatsApp Cloud API (Meta)
WHATSAPP_ENABLED=False
WHATSAPP_DRY_RUN=False
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_HTTP_TIMEOUT=15

# v83 cohortes
COHORT_WAITLIST_OFFER_HOURS=24

# V92 · Premium lifecycle
PREMIUM_RENEWAL_LEAD_HOURS=72
PREMIUM_RENEWAL_GRACE_HOURS=48
PREMIUM_RENEWAL_BATCH_SIZE=100
PREMIUM_SETTLEMENT_BATCH_SIZE=200
