SECRET_KEY=dev-secret-key-change-me
DEBUG=True
# Throttling global catalogue/API. Les actions sensibles ont leurs propres quotas.
ANON_THROTTLE_RATE=10000/hour
USER_THROTTLE_RATE=30000/hour
MEDIA_THROTTLE_RATE=5000/hour
CERTIFICATE_VERIFY_THROTTLE_RATE=300/hour
ALLOWED_HOSTS=*
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000

# Finance / devise comptable
PAYMENT_CURRENCY=EUR
PLATFORM_COMMISSION_PERCENT=15
MINIMUM_PAYOUT_AMOUNT=10
STRIPE_SECRET_KEY=
STRIPE_TEST_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# Paiements additionnels (secrets uniquement côté serveur)
YOUCANPAY_ACCESS_TOKEN=
YOUCANPAY_API_BASE=https://youcanpay.com/api/v2
YOUCANPAY_SANDBOX_ACCESS_TOKEN=
YOUCANPAY_SANDBOX_API_BASE=
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
GENIUSPAY_API_BASE=https://geniuspay.ci/api/v1/merchant
GENIUSPAY_SANDBOX_API_KEY=
GENIUSPAY_SANDBOX_API_SECRET=
GENIUSPAY_SANDBOX_WEBHOOK_SECRET=
GENIUSPAY_SANDBOX_API_BASE=

# CinetPay Mobile Money (Côte d'Ivoire, Sénégal, Cameroun, etc.)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_API_BASE=https://api-checkout.cinetpay.com/v2
CINETPAY_SANDBOX_API_KEY=
CINETPAY_SANDBOX_SITE_ID=
CINETPAY_SANDBOX_SECRET_KEY=
CINETPAY_SANDBOX_API_BASE=

# Stockage média persistant (recommandé/nécessaire sur Railway)
USE_S3=False
# Avec DEBUG=False, le stockage distant est requis par défaut. Sur Railway gardez True.
REQUIRE_REMOTE_MEDIA=True
# Upload vidéo direct navigateur -> S3/R2 par blocs (recommandé en production).
DIRECT_MEDIA_UPLOADS_ENABLED=True
DIRECT_UPLOAD_PART_SIZE_MB=16
DIRECT_UPLOAD_URL_TTL_SECONDS=3600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
# V89: CDN public optionnel avec accès origine au bucket privé. Exemple: https://media.example.com
PUBLIC_MEDIA_BASE_URL=
MEDIA_PUBLIC_CACHE_SECONDS=31536000
MEDIA_PRIVATE_CACHE_CONTROL=private, no-store
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=10
MULTIPART_UPLOAD_MAX_AGE_HOURS=24
MULTIPART_CLEANUP_MAX_ABORTS=200
OPERATIONS_STORAGE_SCAN_MAX_OBJECTS=2000
OPERATIONS_QUEUE_WARNING_DEPTH=100

# Uploads pédagogiques
MAX_VIDEO_UPLOAD_MB=2048
MAX_PDF_UPLOAD_MB=100
MAX_IMAGE_UPLOAD_MB=15
PRIVATE_MEDIA_TOKEN_MAX_AGE=900
HLS_MEDIA_TOKEN_MAX_AGE=21600
VIDEO_NORMALIZATION_ENABLED=True
VIDEO_PROBE_TIMEOUT_SECONDS=120
VIDEO_TRANSCODE_TIMEOUT_SECONDS=3600
VIDEO_TRANSCODE_PRESET=veryfast
VIDEO_TRANSCODE_CRF=22
HLS_STREAMING_ENABLED=True
HLS_MAX_HEIGHT=720
HLS_SEGMENT_SECONDS=6
HLS_TRANSCODE_TIMEOUT_SECONDS=7200
HLS_TRANSCODE_PRESET=veryfast
HLS_AUDIO_ONLY_BITRATE=48k
HLS_DATA_SAVER_MAX_HEIGHT=360
HLS_SEGMENT_CACHE_SECONDS=600

# --- WhatsApp Cloud API (Meta) ---
# En local : activez WHATSAPP_ENABLED=True + laissez WHATSAPP_DRY_RUN=True pour tester sans envoi réel.
# En production : WHATSAPP_DRY_RUN=False et renseignez les identifiants Meta.
WHATSAPP_ENABLED=False
WHATSAPP_DRY_RUN=True
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_HTTP_TIMEOUT=15


# Projets / portfolio
MAX_PROJECT_UPLOAD_MB=50

# Authentification JWT durcie : le refresh vit uniquement dans un cookie HttpOnly.
AUTH_REFRESH_COOKIE_NAME=learneas_refresh
AUTH_REFRESH_COOKIE_PATH=/api/auth/
AUTH_REFRESH_COOKIE_DOMAIN=
# En production HTTPS : True obligatoire. En développement HTTP local : False.
AUTH_REFRESH_COOKIE_SECURE=False
# Lax est recommandé avec le proxy Vercel /api same-origin. N'utilisez None que si l'API est
# appelée réellement cross-site, avec AUTH_REFRESH_COOKIE_SECURE=True.
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_MAX_AGE=604800

# Antivirus des documents (PDF/Office/ZIP). En production MALWARE_SCAN_REQUIRED=True par défaut.
# Déployez un service clamd accessible depuis Railway, puis activez-le ici.
MALWARE_SCAN_ENABLED=False
MALWARE_SCAN_REQUIRED=False
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# WebSocket / Django Channels
REALTIME_TICKET_MAX_AGE_SECONDS=60
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
REALTIME_CHANNEL_CAPACITY=500
REALTIME_CHANNEL_EXPIRY_SECONDS=60

# WebRTC ICE/TURN — secrets uniquement côté backend
RTC_STUN_URL=stun:stun.l.google.com:19302
RTC_TURN_URL=
RTC_TURN_SECRET=
RTC_TURN_TTL_SECONDS=3600
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# Resend Email API — emails transactionnels HTML KalanPro
# Local : RESEND_ENABLED=True + RESEND_DRY_RUN=True pour simuler sans envoyer.
# Production : vérifier le domaine dans Resend, puis RESEND_DRY_RUN=False + clé re_...
RESEND_ENABLED=False
RESEND_DRY_RUN=True
RESEND_API_KEY=
RESEND_API_BASE=https://api.resend.com
RESEND_HTTP_TIMEOUT=15

# --- KalanPro AI · Phase 1 ---
# Local : AI_DRY_RUN=True permet de tester UI, historique, contexte, RAG et quotas sans appel externe.
# Production : AI_DRY_RUN=False + clé + modèle d'un fournisseur compatible chat completions.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_CHAT_MODEL=
AI_PROVIDER_NAME=Compatible API
AI_HTTP_TIMEOUT=60

# Réconciliation de secours des paiements externes (webhooks perdus/retardés)
PAYMENT_RECONCILIATION_MIN_AGE_SECONDS=120
PAYMENT_RECONCILIATION_BATCH_SIZE=100
AI_DRY_RUN=False
AI_INDEX_ASYNC=True
AI_VISION_ENABLED=False
AI_REBUILD_INDEX_ON_BOOT=False
AI_THROTTLE_RATE=30/min

# Paiements externes : réconciliation/audit opérationnel
PAYMENT_ORDER_EXPIRY_HOURS=24
PAYMENT_STALE_BATCH_SIZE=200

# --- Vidéo hors connexion contrôlée (v81) ---
# Génère une copie MP4 basse définition uniquement pour les leçons explicitement autorisées.
OFFLINE_VIDEO_ENABLED=True
OFFLINE_VIDEO_MAX_HEIGHT=360
OFFLINE_VIDEO_MAX_MB=250
# 30 jours : durée maximale du jeton signé permettant de resynchroniser le temps vu hors ligne.
OFFLINE_PROGRESS_TOKEN_MAX_AGE=2592000

# v83 cohortes
COHORT_WAITLIST_OFFER_HOURS=24

# V92 · Premium lifecycle
PREMIUM_RENEWAL_LEAD_HOURS=72
PREMIUM_RENEWAL_GRACE_HOURS=48
PREMIUM_RENEWAL_BATCH_SIZE=100
PREMIUM_SETTLEMENT_BATCH_SIZE=200
